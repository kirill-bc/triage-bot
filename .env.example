# Copy to `.env` and fill in. Never commit `.env`.

# Required for API clients
JIRA_API_KEY=
OPENROUTER_API_KEY=
TRIAGE_WEBHOOK_TOKEN=
# TRIAGE_TEXT_MODEL=openai/gpt-4o-mini
# TRIAGE_OPENROUTER_HTTP_TIMEOUT_SECONDS=60
# TRIAGE_OPENROUTER_HTTP_MAX_RETRIES=2

# Image attachment preprocessing (vision → text in issue_block; default off)
# TRIAGE_IMAGE_CONTEXT_ENABLED=false
# TRIAGE_VISION_MODEL=google/gemini-2.0-flash-001
# TRIAGE_IMAGE_CONTEXT_MAX_ATTACHMENTS=5
# TRIAGE_IMAGE_CONTEXT_MAX_BYTES_PER_IMAGE=5242880
# TRIAGE_IMAGE_CONTEXT_TIMEOUT_SECONDS=90
# TRIAGE_COMMENTS_CHAR_BUDGET=6000
# TRIAGE_AUDIT_REDACT_IMAGE_TRANSCRIPT=true
# Live OpenRouter smoke (optional): export OPENROUTER_LIVE_SMOKE=1 then pytest -m integration

# Optional Zendesk enrichment (ticket ids from Jira custom fields, then Zendesk API)
# TRIAGE_ZENDESK_CONTEXT_ENABLED=false
# OAuth confidential client (Admin Center > Apps and integrations > APIs > OAuth clients)
# ZENDESK_BASE_URL=https://your-subdomain.zendesk.com
# ZENDESK_SUBDOMAIN=your-subdomain
# ZENDESK_IDENTIFIER=jira_bug_triage_bot
# ZENDESK_SECRET=
# ZENDESK_OAUTH_SCOPE=read
# TRIAGE_JIRA_ZENDESK_TICKET_IDS_FIELD_ID=customfield_10158
# TRIAGE_JIRA_IMPORTED_ZENDESK_TICKET_IDS_FIELD_ID=customfield_10162
# TRIAGE_JIRA_ZENDESK_TICKET_COUNT_FIELD_ID=customfield_10157
# TRIAGE_ZENDESK_HTTP_TIMEOUT_SECONDS=20
# TRIAGE_ZENDESK_MAX_TICKETS=3
# TRIAGE_ZENDESK_MAX_COMMENTS_PER_TICKET=20
# TRIAGE_ZENDESK_COMMENT_SUMMARY_ENABLED=false
# TRIAGE_ZENDESK_SUMMARY_MODEL=
# TRIAGE_ZENDESK_SUMMARY_TIMEOUT_SECONDS=60
# TRIAGE_ZENDESK_COMMENTS_CHAR_BUDGET=4000

# Langfuse payload size (generations + audit metadata sent to Langfuse UI)
# TRIAGE_LANGFUSE_TRUNCATE_PAYLOADS=false
# TRIAGE_LANGFUSE_MAX_STRING_CHARS=8192

# Prompt management via Langfuse (optional; falls back to local prompt_templates.json if unset/unavailable)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# TRIAGE_LANGFUSE_PROMPTS_ENABLED=true
# TRIAGE_LANGFUSE_REASON_FOR_HUMANS_PROMPT_NAME=triagebot/reason-for-humans
# TRIAGE_LANGFUSE_CLASSIFICATION_PROMPT_NAME=triagebot/classification-user
# TRIAGE_LANGFUSE_PRIORITY_PROMPT_NAME=triagebot/priority-user
# TRIAGE_LANGFUSE_CLASSIFICATION_SYSTEM_PROMPT_NAME=triagebot/classification-system
# TRIAGE_LANGFUSE_PRIORITY_SYSTEM_PROMPT_NAME=triagebot/priority-system
# TRIAGE_LANGFUSE_VISION_SYSTEM_PROMPT_NAME=triagebot/vision-system
# TRIAGE_LANGFUSE_VISION_USER_PROMPT_NAME=triagebot/vision-user
# TRIAGE_LANGFUSE_ZENDESK_SUMMARY_SYSTEM_PROMPT_NAME=triagebot/zendesk-summary-system
# TRIAGE_LANGFUSE_ZENDESK_SUMMARY_USER_PROMPT_NAME=triagebot/zendesk-summary-user
# TRIAGE_LANGFUSE_PROMPT_LABEL=production
# TRIAGE_LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60

# Jira Cloud REST (set before the Jira fetcher is used)
# JIRA_USER_EMAIL=your-atlassian-account@example.com
# Atlassian gateway (same as curl -u email:api_key):
# JIRA_CLOUD_ID=your-site-cloud-id
# Optional custom Jira field id for reproduction steps (default customfield_10251)
# TRIAGE_JIRA_REPRODUCTION_STEPS_FIELD_ID=customfield_10251

# Jira auto-apply (default off; escalation/prioritization stays advisory-only)
# TRIAGE_AUTO_APPLY_DEESCALATION=false
# TRIAGE_AUTO_APPLY_BUG_TO_STORY=false

# Triage analytics dashboard (optional; fire-and-forget POST after successful triage)
# ANALYTICS_DASHBOARD_URL=http://localhost:8080/api/v1
# ANALYTICS_TOKEN=
# ANALYTICS_HTTP_TIMEOUT_SECONDS=2

# Logging (optional; stdout for container/CloudWatch; inbound/outbound HTTP at INFO)
# LOG_LEVEL=INFO
# LOGGING_API_KEY=
# LOGGING_ENDPOINT=
